# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connect -> "Session pooler" (IPv4, works on Render).
# Replace [YOUR-PASSWORD]. postgres:// and postgresql:// are both accepted.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret key (sb_secret_...) or legacy service_role key. NEVER put this in the frontend.
SUPABASE_SECRET_KEY=
# Only needed if your project still signs user tokens with the legacy shared JWT secret (HS256).
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Private admin access: comma-separated emails allowed to access /api/v1/admin (empty = no admins).
ADMIN_EMAILS=

# AI providers. Get a key at https://aistudio.google.com/apikey
TEXT_AI_PROVIDER=gemini
EVALUATION_AI_PROVIDER=gemini
LIVE_AI_PROVIDER=gemini_live
GEMINI_API_KEY=
# Model IDs verified against https://ai.google.dev/gemini-api/docs/models (Oct 2026).
# Flash-Lite has a much larger free daily quota than Flash; check yours in AI Studio.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EVALUATION_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_API_VERSION=v1alpha
# Optional prebuilt voice name, e.g. Puck, Kore. Leave empty for the model default.
GEMINI_LIVE_VOICE=

# Optional Groq fallback (only used if you set TEXT_AI_PROVIDER=groq / EVALUATION_AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_TEXT_MODEL=

# Limits and timeouts
AI_REQUEST_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=5242880
RECORDING_MAX_BYTES=52428800
DAILY_INTERVIEW_LIMIT=5
DOCUMENT_RETENTION_DAYS=30

# Background worker (evaluation jobs, cleanup). Keep true unless you run a separate worker.
RUN_WORKER=true
