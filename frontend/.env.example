# Copy to frontend/.env.local for local development.
# Public values only: everything here is visible in the browser.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or legacy anon key. Never the secret/service key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend base URL (no trailing slash). On Render: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match the backend's RECORDING_MAX_BYTES (Supabase Free: 50 MB per file).
NEXT_PUBLIC_RECORDING_MAX_BYTES=52428800
